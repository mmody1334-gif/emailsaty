{
  "name": "emailsaty",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Smart 24/7 Temporary Email Service & Telegram Bot on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tg:setup": "node scripts/setup-telegram.mjs",
    "tg:delete": "node scripts/setup-telegram.mjs --delete"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
